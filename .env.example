# Supabase Configuration Template
# Salin file ini menjadi .env dan masukkan Project URL & Anon Key dari Supabase Anda
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (untuk fitur perhitungan kalori makanan pintar)
# Dapatkan gratis di https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
